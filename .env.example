# Server Configuration
PORT=3000
NODE_ENV=development

# Market Data API - Choose ONE provider
# Option 1: Finnhub (Free tier: 60 calls/min, recommended)
FINNHUB_API_KEY=your_free_api_key_from_https://finnhub.io

# Option 2: Alpaca (Free tier available)
# ALPACA_API_KEY=your_key
# ALPACA_API_SECRET=your_secret

# Option 3: PolygonIO (Free tier)
# POLYGON_API_KEY=your_key

# Paper Trading Configuration
PAPER_TRADING_ONLY=true
TRADING_MODE=paper

# Initial Paper Account Balance
PAPER_ACCOUNT_STARTING_BALANCE=100000

# Scanner Settings
SCAN_INTERVAL_SECONDS=60
MAX_STOCKS_TO_SCAN=100
CACHE_DURATION_MINUTES=5

# Security - Never expose in frontend
API_KEYS_SERVER_ONLY=true
